{
  "name": "dw-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core --noEmit && pnpm --filter @dw/app typecheck",
    "lint": "eslint --max-warnings 0 packages app",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "pnpm --filter @dw/app build && pnpm --filter @dw/app presupuesto",
    "dev": "pnpm --filter @dw/app dev",
    "check": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
