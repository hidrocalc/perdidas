{
  "name": "dw-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core --noEmit",
    "lint": "eslint --max-warnings 0 packages",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm coverage"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
