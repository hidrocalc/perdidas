{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview --port 4175 --strictPort",
      "startServerReadyPattern": "4175",
      "url": ["http://localhost:4175/perdidas/", "http://localhost:4175/perdidas/#tablas"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse"
    }
  }
}
